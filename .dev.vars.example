# Copy to `.dev.vars` (git-ignored) for local development. Never commit real values.
# Production: set each with `npx wrangler secret put <NAME>` instead.
# A provider is shown on the login screen only when its keys are set.
#
# Redirect URIs to register in each developer console:
#   local:      http://localhost:5173/api/auth/<provider>/callback
#   production: https://memo-assistant.ggyaal.workers.dev/api/auth/<provider>/callback

# Discord Developer Portal → Applications → OAuth2 (scope used: identify)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Same application → Bot → Reset Token. Used only to DM users their own reminders.
# The bot must share a server with the user (invite it with OAuth2 URL Generator, scope "bot", no permissions).
DISCORD_BOT_TOKEN=
# Optional: public invite link to that server, shown to users who cannot receive DMs yet.
DISCORD_SERVER_INVITE=
# Server (guild) id of that server: Discord notifications unlock only after the user joins it.
DISCORD_GUILD_ID=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Scopes used: openid email profile (no Gmail scope). The ID token is verified (signature, iss, aud, exp, nonce).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Developers → 앱 → 앱 키 "REST API 키" / 카카오 로그인 활성화 ON / 동의항목: 닉네임(profile_nickname)
# Client Secret: only if "사용함" is ON in the console (then it is required).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# E-mail reminders (sent by this service via Resend, never from the user's Gmail).
# Resend needs a domain you own, verified in Resend (DNS records). Without both values e-mail stays off.
EMAIL_API_KEY=
# A sender on that verified domain, e.g. 메모비서 <noreply@your-domain.com>
EMAIL_FROM=
# Optional: daily cap on e-mails (Resend Free allows 100/day). Default 90.
# EMAIL_DAILY_LIMIT=90
